{
  "manifest_version": 3,
  "name": "NerdVPN",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "description": "Redirects visits to X, Reddit, and paywalled news sites to alternative domains.",
  "background": {
    "service_worker": "redirect-service-worker.js"
  },
  "action": {
    "default_popup": "background.html",
    "default_title": "NerdVPN redirects"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "xRedirects",
        "enabled": true,
        "path": "rules/x_redirects.json"
      },
      {
        "id": "redditRedirects",
        "enabled": true,
        "path": "rules/reddit_redirects.json"
      },
      {
        "id": "paywallArchiveRedirects",
        "enabled": true,
        "path": "rules/paywall_archive_redirects.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://nitter.cf/*",
        "https://reddit.nerdvpn.de/*",
        "https://archive.is/*"
      ],
      "js": ["redirect-notice.js"],
      "run_at": "document_idle"
    }
  ]
}
